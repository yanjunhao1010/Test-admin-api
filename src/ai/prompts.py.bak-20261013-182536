def schema_text(output_schema: Optional[Dict[str, Any]]) -> str:
    if not output_schema:
        return ''
    return json.dumps(output_schema, ensure_ascii=False, indent=2)


def render(template: Optional[str], values: Optional[Dict[str, Any]]) -> str:
    """把 {{变量}} 替换成实际值。只替换已知 key，避免误伤正文里的 {{ }} """
    if not template:
        return ''
    out = template
    for key, val in (values or {}).items():
        if val is None:
            val = ''
        out = out.replace('{{%s}}' % key, str(val))
    # 未传的占位符清空：残留 {{xxx}} 会被模型当成正文噪音，json_object 模式下还会诱发格式错误
    out = _UNRESOLVED_RE.sub('', out)
    return out


_UNRESOLVED_RE = re.compile(r'\{\{\s*[a-zA-Z_][a-zA-Z0-9_]*\s*\}\}')


def get_prompt(db, code: str, uid: int = None) -> Dict[str, Any]:
    """取模板：本人 personal 优先 -> 全局默认 -> 内置默认。

    - personal：scope='personal' 且 create_by=uid，仅本人可见/可用/可改
    - global：scope='global'，所有人共用（由 admin 维护）
    - 都没有时回退到 BUILTIN_PROMPTS 内置默认
    """
    builtin = BUILTIN_PROMPTS.get(code)
    result = dict(builtin) if builtin else {
        'name': code, 'model_type': 'chat', 'temperature': 0.30,
        'system': '', 'user': '', 'output_schema': None, 'description': '',
    }
    result['code'] = code
    result['prompt_id'] = None
    result['version'] = 0
    result['scope'] = 'builtin'

    def _fill(row):
        result['prompt_id'] = row['id']
        result['version'] = row['version'] or 0
        result['scope'] = row.get('scope') or 'global'
        if row.get('name'):
            result['name'] = row['name']
        if row.get('model_type'):
            result['model_type'] = row['model_type']
        if row.get('temperature') is not None:
            result['temperature'] = float(row['temperature'])
        if row.get('system_prompt'):
            result['system'] = row['system_prompt']
        if row.get('user_prompt_template'):
            result['user'] = row['user_prompt_template']
        if row.get('output_schema'):
            try:
                result['output_schema'] = json.loads(row['output_schema'])
            except Exception:
                pass
        return result

    if db is None:
        return result
    try:
        # 1) 本人 personal 优先
        if uid:
            rows = db.execute_query(
                'SELECT id, name, model_type, temperature, system_prompt, user_prompt_template, '
                'output_schema, version, scope FROM ai_prompts '
                'WHERE code = %s AND scope = \'personal\' AND create_by = %s '
                'AND enabled = 1 AND is_del = 0 ORDER BY version DESC LIMIT 1',
                (code, uid))
            if rows:
                return _fill(rows[0])
        # 2) 全局默认
        rows = db.execute_query(
            'SELECT id, name, model_type, temperature, system_prompt, user_prompt_template, '
            'output_schema, version, scope FROM ai_prompts '
            'WHERE code = %s AND scope = \'global\' AND enabled = 1 AND is_del = 0 '
            'ORDER BY version DESC LIMIT 1',
            (code,))
        if rows:
            return _fill(rows[0])
    except Exception:
        return result
    return result


def list_builtin_codes():
    return list(BUILTIN_PROMPTS.keys())
