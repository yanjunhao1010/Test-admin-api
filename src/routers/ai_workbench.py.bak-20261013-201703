                    'UPDATE ai_case_drafts SET status = 1, adopt_case_id = %s, adopt_project_id = %s, '
                    'adopt_by = %s, adopt_time = NOW() WHERE id = %s',
                    (new_id, data.project_id, uid, d['id']))
