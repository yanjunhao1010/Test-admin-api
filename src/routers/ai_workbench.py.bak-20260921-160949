class ReqAnalyseReq(BaseModel):
    requirement_id: int
    model_id: Optional[int] = None
    max_blocks: int = 8        # 单次最多分析的章节块数，避免同步请求过长
    text_only: int = 0         # 1=直接粘贴的文本（不通过文件）


@router.post('/requirement/analyse')
async def analyse_requirement(request: Request, data: ReqAnalyseReq):
    """分块抽取功能点/测试点/风险/疑问，汇总去重后写回 ai_requirements"""
    try:
        uid = _uid(request)
        with get_db_handler() as db:
            rows = db.execute_query(
                'SELECT id, title, content_text FROM ai_requirements WHERE id = %s AND is_del = 0',
                (data.requirement_id,))
            if not rows:
                raise HTTPException(status_code=404, detail='需求文档不存在')
            req = rows[0]
            text = req.get('content_text') or ''
            if not text.strip():
                raise HTTPException(status_code=400, detail='该需求文档没有正文，无法分析')

            blocks = docs_mod.split_blocks(text)
            if not blocks:
                raise HTTPException(status_code=400, detail='文档内容为空，无法分块分析')
            used = blocks[:max(1, min(int(data.max_blocks or 8), 20))]

            db.execute_update('UPDATE ai_requirements SET status = 1 WHERE id = %s', (req['id'],))

            all_points: List[Dict[str, Any]] = []
            dropped: List[Dict[str, str]] = []
            model_used = None
            total_elapsed = 0
            try:
                for b in used:
                    result = runner.run_structured(
                        db, uid, biz_type='req_analyse', prompt_code='req_analyse',
                        prompt_vars={
                            'title': req.get('title') or '',
                            'section_path': b.get('section_path') or '正文',
                            'block_text': b['text'],
                        },
                        list_key='function_points', item_model=schema_mod.FunctionPointItem,
                        model_id=data.model_id,
                    )
                    all_points.extend(result['items'])
                    dropped.extend(result['dropped'])
                    model_used = result['model']
                    total_elapsed += result['elapsed_ms']
            except Exception:
                db.execute_update('UPDATE ai_requirements SET status = 3 WHERE id = %s', (req['id'],))
                raise

            # 跨块去重：同「模块+功能点」合并；重复出现的功能点标记为核心链路
            merged: Dict[str, Dict[str, Any]] = {}
            for p in all_points:
                key = '%s|%s' % (p.get('module') or '', p.get('function_point') or '')
                if key in merged:
                    m = merged[key]
                    m['appear_count'] = (m.get('appear_count') or 1) + 1
                    for f in ('test_points', 'risks', 'questions'):
                        m[f] = list({*(m.get(f) or []), *(p.get(f) or [])})
                    if not m.get('description'):
                        m['description'] = p.get('description') or ''
                else:
                    item = dict(p)
                    item['appear_count'] = 1
                    merged[key] = item
            points = sorted(merged.values(), key=lambda x: -(x.get('appear_count') or 1))

            analyse_result = {
                'blocks_total': len(blocks),
                'blocks_analysed': len(used),
                'function_points': points,
                'dropped': dropped,
                'model': model_used,
                'elapsed_ms': total_elapsed,
            }
            db.execute_update(
                'UPDATE ai_requirements SET status = 2, analyse_result = %s WHERE id = %s',
                (json.dumps(analyse_result, ensure_ascii=False, default=str), req['id']))

            return _ok({
                'requirement_id': req['id'],
                'title': req.get('title'),
                'blocks_total': len(blocks),
                'blocks_analysed': len(used),
                'function_points': points,
                'dropped': dropped,
                'model': model_used,
                'elapsed_ms': total_elapsed,
            }, '已分析 %d/%d 个章节块，识别出 %d 个功能点' % (len(used), len(blocks), len(points)))
    except HTTPException:
        raise
    except AIError as e:
        _raise_ai(e)
    except Exception as e:  # noqa: BLE001
        raise HTTPException(status_code=500, detail='需求分析失败：%s' % e)


