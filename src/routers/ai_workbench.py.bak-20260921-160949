class CaseGenReq(BaseModel):
    project_id: Optional[int] = None
    project_name: str = ''
    module: str = ''
    function_point: str = ''
    requirement: str = ''
    case_types: str = '正向,异常,边界'
    count: int = 5
    model_id: Optional[int] = None


def _few_shot_text(db, module: str, limit: int = 4) -> str:
    """取库内同模块已有用例，作为风格参考（few-shot），保证生成风格一致"""
    if module:
        rows = db.execute_query(
            'SELECT module, function_point, pre_condition, steps, expected_result FROM test_cases '
            'WHERE is_del = 0 AND module = %s ORDER BY id DESC LIMIT %s', (module, limit))
    else:
        rows = db.execute_query(
            'SELECT module, function_point, pre_condition, steps, expected_result FROM test_cases '
            'WHERE is_del = 0 ORDER BY id DESC LIMIT %s', (limit,))
    if not rows:
        return '（库内暂无同模块用例）'
    lines = []
    for r in rows:
        lines.append('模块：%s / 功能点：%s\n前置条件：%s\n步骤：%s\n预期结果：%s'
                     % (r.get('module') or '', r.get('function_point') or '',
                        r.get('pre_condition') or '', r.get('steps') or '',
                        r.get('expected_result') or ''))
    return '\n---\n'.join(lines)


@router.post('/case-gen')
async def case_gen(request: Request, data: CaseGenReq):
    """生成用例 → 统一落 ai_case_drafts 草稿池（不直接进 test_cases）"""
    try:
        uid = _uid(request)
        count = max(1, min(int(data.count or 5), 10))  # 单次上限 10 条，避免长响应超时
        with get_db_handler() as db:
            project_name = data.project_name
            if not project_name and data.project_id:
                rows = db.execute_query('SELECT cate_name FROM test_case_project WHERE id = %s', (data.project_id,))
                project_name = rows[0]['cate_name'] if rows else ''

            result = runner.run_structured(
                db, uid, biz_type='case_gen', prompt_code='case_gen',
                prompt_vars={
                    'project_name': project_name or '未指定',
                    'module': data.module or '未指定',
                    'function_point': data.function_point or '未指定',
                    'case_types': data.case_types or '正向,异常,边界',
                    'count': count,
                    'requirement': data.requirement or '（未填写需求说明，请依据功能点与参考用例推断）',
                    'few_shot': _few_shot_text(db, data.module),
                },
                list_key='cases', item_model=schema_mod.CaseDraftItem, limit=count,
                model_id=data.model_id,
            )

            batch = _batch_id()
            saved = []
            for item in result['items']:
                # 去重提示：库内已有同 模块+功能点 时标出疑似重复
                dup_id = None
                rows = db.execute_query(
                    'SELECT id FROM test_cases WHERE is_del = 0 AND module = %s AND function_point = %s LIMIT 1',
                    (item.get('module') or data.module or '', item.get('function_point') or ''))
                if rows:
                    dup_id = rows[0]['id']
                item_id = _insert_id(
                    db,
                    'INSERT INTO ai_case_drafts (batch_id, source_type, suggest_project_id, module, '
                    'function_point, priority, case_type, pre_condition, case_steps, expected_result, '
                    'remark, confidence, dup_case_id, status, model_id, run_by) '
                    'VALUES (%s,1,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,0,%s,%s)',
                    (batch, data.project_id, item.get('module') or data.module or '',
                     item.get('function_point') or '', item.get('priority') or 2,
                     item.get('case_type') or '', item.get('pre_condition') or '',
                     item.get('steps') or '', item.get('expected_result') or '',
                     item.get('remark') or '', item.get('confidence') or 0, dup_id,
                     result['model']['id'], uid),
                )
                item['id'] = item_id
                item['dup_case_id'] = dup_id
                saved.append(item)

            return _ok({
                'batch_id': batch,
                'items': saved,
                'dropped': result['dropped'],
                'model': result['model'],
                'usage': result['usage'],
                'elapsed_ms': result['elapsed_ms'],
                'attempt': result['attempt'],
                'masked_count': result['masked_count'],
            }, '已生成 %d 条用例草稿，请到「AI用例库」确认后加入项目' % len(saved))
    except HTTPException:
        raise
    except AIError as e:
        _raise_ai(e)
    except Exception as e:  # noqa: BLE001
        raise HTTPException(status_code=500, detail='生成用例失败：%s' % e)


